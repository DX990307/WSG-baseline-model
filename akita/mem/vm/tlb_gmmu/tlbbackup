func (tlb *GMMUTLB) sendToIOMMU(
	req *vm.TranslationReq,
	now sim.VTimeInSec,
	Bitmap [8]bool,
) (*vm.TranslationReq, bool) {
	if tlb.IOMMUPort == nil {
		log.Panicf("GMMUTLB %s does not have an IOMMU port", tlb.Name())
	}

	newReq := vm.TranslationReqBuilder{}.
		WithSendTime(now).
		WithSrc(tlb.OutsidePort).
		WithDst(tlb.IOMMUPort).
		WithPID(req.PID).
		WithVAddr(req.VAddr).
		WithDeviceID(tlb.DeviceID).
		WithTaskID(req.TaskID).
		WithOriginPort(req.OriginPort).
		WithBitMap(Bitmap).
		Build()

	fmt.Printf("TLB Send to IOMMU %s, %d, %d\n", tlb.Name(), req.VAddr, newReq.DeviceID)

	// fmt.Printf("IOMMU %d,%s,%d\n", uint64(now*1e9), req.Src.Name(), req.VAddr>>12)

	err := tlb.IOMMUPort.Send(newReq)
	if err != nil {
		return nil, false
	}

	return newReq, true
}

func (tlb *GMMUTLB) createBOEntryIfNotExist(page vm.Page, req *vm.TranslationReq) {
	newEntry := &BOTableEntry{
		PID:                   req.PID,
		PageBlock:             page.PageBlock,
		Granularity:           2,
		WaitingATRsPrediction: 1,
		Valid:                 true,
	}
	tlb.BOTable.AddEntry(newEntry)
}

func (tlb *GMMUTLB) createNewBitmap(vaddr uint64, radius int) [8]bool {
	bitmap := [8]bool{}
	vpn := vaddr >> 12

	for i := 0; i <= radius; i++ {
		if vpn%8+uint64(i) < 8 {
			bitmap[vpn%8+uint64(i)] = true
		}
		if vpn%8 >= uint64(i) {
			bitmap[vpn%8-uint64(i)] = true
		}
	}
	return bitmap
}
